## Sanity Project ID
## Add the ID to both NEXT_PUBLIC_ & SANITY_STUDIO_
## Which is mandatory for localhost:3333 and localhost:3000

NEXT_PUBLIC_SANITY_PROJECT_ID=
SANITY_STUDIO_PROJECT_ID=

NEXT_PUBLIC_SANITY_DATASET=production
SANITY_REVALIDATE_SECRET=your-secret-key-here

## Sanity write token (Editor role) — required for creating bookings.
## Create at sanity.io/manage → API → Tokens.
SANITY_API_WRITE_TOKEN=

## Resend — transactional emails (payment instructions, confirmations).
## Without a key, emails are logged to the server console instead of sent.
RESEND_API_KEY=
EMAIL_FROM="Tvorivko <ahoj@tvorivko.sk>"

## Shared secret for the Sanity → /api/booking/confirmed webhook.
## Use any long random string; set the same value in the webhook's
## x-webhook-secret header at sanity.io/manage → API → Webhooks.
SANITY_WEBHOOK_SECRET=

## Stripe — card payments. Without keys, the card option returns a
## friendly "unavailable" error and bank transfer keeps working.
## STRIPE_WEBHOOK_SECRET is the signing secret of the webhook endpoint
## (dashboard.stripe.com → Developers → Webhooks → /api/stripe/webhook).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
